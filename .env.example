# ==============================================================================
# DEKO LABS WEB - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# CERO SECRETOS HARDCODEADOS: Nunca agregues valores de producción a este archivo.
# Copia este archivo a `.env` y configura tus variables de entorno seguras.

# Configuración del Servidor Express
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://dekolabs.org

# Base de Datos PostgreSQL (Prisma ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://dekolabs_user:dekolabs_secure_pass@localhost:5432/dekolabs_db?schema=public

# Almacenamiento Cloud para Multimedia (Cero Base64 en DB o Código)
GCS_PUBLIC_URL=https://storage.googleapis.com/dekolabs-assets

# Conectividad Segura con el Ecosistema
# URL base para proxy hacia Deco Vintage y JARVIS
DECO_VINTAGE_API_URL=https://decovintage.online/api

# Google AI Studio / Gemini API (Para procesamiento de lenguaje natural en el servidor)
# Obligatorio para el parser de transacciones en lenguaje natural del backend
GEMINI_API_KEY=
